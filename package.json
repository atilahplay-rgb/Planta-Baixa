{
  "name": "planta-baixa",
  "version": "1.0.0",
  "description": "Aplicativo para desenhar plantas baixas",
  "author": "Planta Baixa",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  },
  "build": {
    "appId": "com.local.plantabaixa",
    "productName": "Planta Baixa",
    "files": ["main.js", "preload.js", "index.html", "package.json"],
    "win": { "target": "nsis" },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  }
}
